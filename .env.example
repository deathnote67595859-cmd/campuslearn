# =============================================================================
# CampusLearn Environment Variables (Example Template)
# Copy this file to .env.local and replace placeholders with your actual values.
# NEVER commit .env.local or real secrets to version control.
# =============================================================================

# Managed PostgreSQL Database Connection String
# Example from Neon: postgresql://[user]:[password]@[endpoint].neon.tech/campuslearn?sslmode=require
DATABASE_URL="postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/campuslearn?sslmode=require"

# NextAuth.js Configuration
# URL of your app (http://localhost:3000 for local development)
NEXTAUTH_URL="http://localhost:3000"

# Generate a secure 32-character secret using: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# Google OAuth Credentials (Optional: for Google sign-in)
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Groq AI Service API Key (for CampusAI Study Assistant)
# Obtain free from: https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"
